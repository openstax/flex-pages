{
  "name": "@openstax/flex-page-editor-select-extension",
  "version": "1.0.3",
  "sideEffects": false,
  "dependencies": {
    "react-select": "^5.10.1"
  },
  "devDependencies": {
    "@openstax/ui-components": "github:openstax/ui-components#1.22.4",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "cspell": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import-x": "^4.15.0",
    "globals": "^16.5.0",
    "npm-run-all2": "^7.0.0",
    "typescript-eslint": "^8.48.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "@openstax/flex-page-editor": "^1.1.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "exports": {
    ".": {
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./*": {
      "browser": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/*",
        "dist/esm/*.d.ts",
        "dist/esm/*/index.d.ts"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openstax/flex-pages.git",
    "directory": "packages/flex-page-editor-select-extension"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "index.js",
  "scripts": {
    "build": "./script/build.bash",
    "build:clean": "npm run clean && npm run build",
    "ci": "CI=true npm-run-all ci:*",
    "ci:lint": "eslint --max-warnings=0 .",
    "ci:spelling": "cspell -c ../../cspell.json --gitignore --gitignore-root ../.. '**'",
    "ci:typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
