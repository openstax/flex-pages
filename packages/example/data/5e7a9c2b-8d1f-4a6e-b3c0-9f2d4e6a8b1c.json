              "content": [
                {"type": "text", "value": "<h2>Webinar Library</h2><p>Past webinars, most recent first. Use the subject filter to narrow the list; each card shows its collections as tags. This example caps the list, trims descriptions, and paginates 6 per page.</p>", "id": "0006-text"},
                {"type": "webinar_library", "value": {"count": 18, "description_words": 20, "per_page": 6, "cta_text": "Watch recording"}, "id": "0006-webinar-library"}
