          {
            "type": "section",
            "value": {
              "content": [
                {"type": "text", "value": "<h2>Overview</h2><p>Three blocks render OpenStax webinars from the CMS feed: <b>Upcoming Webinars</b> (a grid of the soonest events), <b>Webinar Library</b> (past webinars, filterable by subject, with collections shown as tags), and <b>Featured Webinar</b> (one webinar highlighted by id). All ship in <code>@openstax/flex-page-os-blocks</code> and load their data server-side. Upcoming vs. past is decided when the page is built, so rebuild to refresh.</p>", "id": "0003-text-overview"}
              ],
              "config": [{"type": "padding_bottom", "value": 1, "id": "0003-cfg-pad"}]
            },
            "id": "0003-section-overview"
          },
          {
            "type": "section",
            "value": {
              "content": [
                {"type": "text", "value": "<h2>Upcoming Webinars</h2><p>The next few webinars, soonest first. Set how many to show, an optional subject, and a description word limit.</p>", "id": "0004-text"},
                {"type": "webinar_upcoming", "value": {"count": 3, "description_words": 25, "cta_text": "Register now"}, "id": "0004-webinar-upcoming"}
              ],
              "config": [{"type": "padding", "value": 1, "id": "0004-cfg-pad"}]
            },
            "id": "0004-section"
          },
          {
            "type": "section",
            "value": {
              "content": [
                {"type": "text", "value": "<h2>Featured Webinar</h2><p>A single webinar highlighted by its id.</p>", "id": "0005-text"},
                {"type": "webinar_highlight", "value": {"webinar_id": 445}, "id": "0005-webinar-highlight"}
              ],
              "config": [{"type": "padding", "value": 1, "id": "0005-cfg-pad"}]
