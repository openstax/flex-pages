            "value": {
              "content": [
                {
                  "type": "text",
                  "value": "<h2 data-block-key=\"bn0ov1\">Overview</h2><p data-block-key=\"bn0ov2\">The Big Number component shows a large statistic with an optional caption, for impact figures like &quot;8M+ learners&quot;.</p>",
                  "id": "bn-overview-text"
                }
              ],
              "config": [
                {
                  "type": "padding_bottom",
                  "value": 1,
                  "id": "bn-overview-padding"
                }
              ]
            },
            "id": "bn-overview-section"
          },
          {
            "type": "section",
            "value": {
              "content": [
                {
                  "type": "text",
                  "value": "<h2 data-block-key=\"bn0cf1\">Config</h2><p data-block-key=\"bn0cf2\"><b>number</b>: the statistic to display large (required).</p><p data-block-key=\"bn0cf3\"><b>caption</b>: optional supporting text shown below the number.</p><p data-block-key=\"bn0cf4\"><b>color</b>: optional brand color for the number (blue, green, or orange). Defaults to the inherited text color.</p>",
                  "id": "bn-config-text"
                }
              ],
              "config": [
                {
                  "type": "padding",
                  "value": 1,
                  "id": "bn-config-padding"
                }
              ]
            },
            "id": "bn-config-section"
          },
          {
            "type": "section",
            "value": {
              "content": [
                {
                  "type": "text",
                  "value": "<h1 data-block-key=\"bn0ex1\">Examples</h1>",
                  "id": "bn-examples-text"
                },
                {
                  "type": "text",
                  "value": "<h3 data-block-key=\"bn0ex2\">Number with caption</h3>",
                  "id": "bn-ex-default-label"
                },
                {
                  "type": "big_number",
                  "value": {
                    "number": "8M+",
                    "caption": "learners reached"
                  },
                  "id": "bn-ex-default"
                },
